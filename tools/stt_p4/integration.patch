+    len = strlen(data);
+  }
+  char tagged[BLE_MSG_MAX_LEN];
+  const size_t previewLen = len < BLE_MSG_MAX_LEN - 4 ? len : BLE_MSG_MAX_LEN - 4;
+  snprintf(tagged, sizeof(tagged), "TX:%.*s", static_cast<int>(previewLen), data);
