diff --git a/components/hardwareone/stt/pointwise_probe.h b/components/hardwareone/stt/pointwise_probe.h
new file mode 100644
index 00000000..98ee02bb
--- /dev/null
+++ b/components/hardwareone/stt/pointwise_probe.h
@@ -0,0 +1,74 @@
+#pragma once
+// Included inside System_STTLocal's anonymous namespace: diagnostic only,
+// before capture/speaker worker start. No transcript, tensor or PCM is logged.
+extern "C" void hw1_dl_pointwise_probe_set(int);
+extern "C" uint32_t hw1_dl_pointwise_probe_count(int);
+void pointwiseBenchmark(Backend& backend) {
+    struct Reset {~Reset(){hw1_dl_pointwise_probe_set(0);}} reset;
+    uint32_t samples=0;memcpy(&samples,gSpeakerFixture,4);
+    const auto* pcm=reinterpret_cast<const int16_t*>(gSpeakerFixture+8);
+    if(!samples || !backend.weights.loaded()) {ESP_LOGE("STT","TL pw_error code=1");return;}
+    uint8_t wantInput[32]={},wantOutput[32]={},wantText[32]={};bool first=true,ok=true;
+    struct Measurement {
+        uint32_t wall=0,inference=0,stages=0,yield=0,calls=0,width1=0,c512=0;
+        size_t lowInternal=0,lowPsram=0,freeInternal=0,freePsram=0;
+        size_t largestInternal=0,largestPsram=0;
+    };
+    auto measure=[&](int mode,Measurement& m) {
+        File file=openModel();
+        if(!file || file.isDirectory())return false;
+        hw1_dl_pointwise_probe_set(mode);
+        hw1::stt::stageProfileReset();
+        hw1::stt::Diagnostics d;STTLocalStats stats;
+        char text[513]={},error[128]={};
+        heap_caps_monitor_local_minimum_free_size_start();
+        const int64_t begin=esp_timer_get_time();
+        const bool call=hw1::stt::transcribe({&file,file.size(),readModel},pcm,samples,text,sizeof(text),{},stats,error,sizeof(error),&d,&backend.weights,nullptr);
+        m.wall=uint32_t(esp_timer_get_time()-begin);
+        m.lowInternal=heap_caps_get_minimum_free_size(MALLOC_CAP_INTERNAL|MALLOC_CAP_8BIT);
+        m.lowPsram=heap_caps_get_minimum_free_size(MALLOC_CAP_SPIRAM);
+        heap_caps_monitor_local_minimum_free_size_stop();
+        if(!call || !stats.weightsReused || stats.lmUsed)return false;
+        uint8_t bitsIn=0,bitsOut=0,hash[32];
+        for(unsigned i=0;i<32;++i) {bitsIn|=d.inputSha[i];bitsOut|=d.outputSha[i];}
+        if(!bitsIn || !bitsOut || mbedtls_sha256(reinterpret_cast<const uint8_t*>(text),strlen(text),hash,0))return false;
+        if(first) {memcpy(wantInput,d.inputSha,32);memcpy(wantOutput,d.outputSha,32);memcpy(wantText,hash,32);first=false;}
+        if(memcmp(wantInput,d.inputSha,32) || memcmp(wantOutput,d.outputSha,32) || memcmp(wantText,hash,32))return false;
+        m.inference=d.inferenceUs;m.yield=stats.inferenceYieldUs;
+        uint32_t stages[256]={},segments=0;
+        const size_t n=hw1::stt::stageProfile(stages,256,&segments);
+        if(segments!=1)return false;
+        for(size_t i=0;i<n;++i)m.stages+=stages[i];
+        m.calls=hw1_dl_pointwise_probe_count(0);m.width1=hw1_dl_pointwise_probe_count(1);m.c512=hw1_dl_pointwise_probe_count(2);
+        m.freeInternal=d.freeInternalAtInference;m.freePsram=d.freePsramAtInference;
+        m.largestInternal=heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL|MALLOC_CAP_8BIT);
+        m.largestPsram=heap_caps_get_largest_free_block(MALLOC_CAP_SPIRAM);
+        return m.inference && m.c512 && m.width1;
+    };
+    // Warm both modes twice, then three alternating matched pairs per boot.
+    Measurement warm;
+    for(int i=0;i<4 && ok;++i)ok=measure(i&1,warm);
+    for(int pair=0;pair<3 && ok;++pair) {
+        Measurement m[2];
+        if(pair&1)ok=measure(1,m[1]) && measure(0,m[0]);
+        else ok=measure(0,m[0]) && measure(1,m[1]);
+        for(int mode=0;mode<2 && ok;++mode) {
+            const auto& v=m[mode];
+            ESP_LOGI("STT","TL pw_time pair=%d mode=%d wall_us=%lu inference_us=%lu stages_us=%lu yield_us=%lu end",pair,mode,(unsigned long)v.wall,(unsigned long)v.inference,(unsigned long)v.stages,(unsigned long)v.yield);
+            ESP_LOGI("STT","TL pw_calls pair=%d mode=%d tiled=%lu width1=%lu c512=%lu end",pair,mode,(unsigned long)v.calls,(unsigned long)v.width1,(unsigned long)v.c512);
+            ESP_LOGI("STT","TL pw_mem pair=%d mode=%d low_int=%u low_psram=%u free_int=%u free_psram=%u largest_int=%u largest_psram=%u end",pair,mode,unsigned(v.lowInternal),unsigned(v.lowPsram),unsigned(v.freeInternal),unsigned(v.freePsram),unsigned(v.largestInternal),unsigned(v.largestPsram));
+        }
+        vTaskDelay(1);
+    }
+    hw1_dl_pointwise_probe_set(0);
+    if(ok) {
+        const uint8_t* hashes[]={wantInput,wantOutput,wantText};
+        const char* kinds[]={"input","output","text"};
+        for(unsigned h=0;h<3;++h) {
+            char hex[65];
+            for(unsigned i=0;i<32;++i)snprintf(hex+2*i,3,"%02x",unsigned(hashes[h][i]));
+            ESP_LOGI("STT","TL pw_hash kind=%s sha=%s end",kinds[h],hex);
+        }
+    }
+    ESP_LOGI("STT","TL pw_done ok=%u hashes_equal=%u warm=4 pairs=3 samples=%lu end",unsigned(ok),unsigned(ok),(unsigned long)samples);
+}
