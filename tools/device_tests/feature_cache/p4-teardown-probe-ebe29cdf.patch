diff --git a/components/hardwareone/stt/teardown_probe.h b/components/hardwareone/stt/teardown_probe.h
new file mode 100644
index 00000000..21f172f3
--- /dev/null
+++ b/components/hardwareone/stt/teardown_probe.h
@@ -0,0 +1,28 @@
+#pragma once
+// Diagnostic app only: numbered teardown boundaries, no PCM/text/pointers.
+// Heap scans perturb timing; these runs locate damage and are not speed tests.
+#if defined(ESP_PLATFORM) && !defined(HW1_STT_SPEAKER_DIAGNOSTICS)
+#error "Include System_STTLocal.h before the teardown probe so every source uses the same diagnostics policy"
+#endif
+#if defined(ESP_PLATFORM) && HW1_STT_SPEAKER_DIAGNOSTICS
+#include "esp_heap_caps.h"
+#include "esp_rom_sys.h"
+#include "esp_timer.h"
+#include <cstdlib>
+namespace hw1::stt {
+inline void teardownProbe(unsigned phase) {
+    esp_rom_printf("TL teardown phase=%u event=0 ms=%u end\n", phase,
+                   unsigned(esp_timer_get_time()/1000));
+    const int64_t begin=esp_timer_get_time();
+    const bool ok=heap_caps_check_integrity_all(false);
+    const unsigned elapsed=unsigned(esp_timer_get_time()-begin);
+    esp_rom_printf("TL teardown phase=%u event=1 ms=%u heap_ok=%u check_us=%u int_free=%u psram_free=%u end\n",
+                   phase,unsigned(esp_timer_get_time()/1000),unsigned(ok),elapsed,
+                   unsigned(heap_caps_get_free_size(MALLOC_CAP_INTERNAL|MALLOC_CAP_8BIT)),
+                   unsigned(heap_caps_get_free_size(MALLOC_CAP_SPIRAM)));
+    if(!ok)std::abort(); // Preserve the first failed boundary; do not allocate through a damaged heap.
+}
+}
+#else
+namespace hw1::stt { inline void teardownProbe(unsigned) {} }
+#endif
