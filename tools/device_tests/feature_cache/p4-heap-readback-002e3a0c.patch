diff --git a/components/hardwareone/stt/heap_trigger_read.h b/components/hardwareone/stt/heap_trigger_read.h
new file mode 100644
index 00000000..77a5b95c
--- /dev/null
+++ b/components/hardwareone/stt/heap_trigger_read.h
@@ -0,0 +1,27 @@
+#pragma once
+#include <cstdint>
+namespace hw1::stt {
+struct HeapTriggerSlot {uint32_t selected=0,data1=0,data2=0,data3=0;};
+struct HeapTriggerRead {
+  uint32_t core=0,debugger=0,before=0,after=0,controlBefore=0,controlAfter=0;
+  HeapTriggerSlot slots[3];
+  bool restored=false,selected=true;
+};
+// The adapter deliberately exposes no write to TDATA or TCONTROL. Only select
+// a slot for reading, then restore the caller's selection and IRQ mask.
+template<class Cpu> HeapTriggerRead readHeapTriggers() {
+  HeapTriggerRead r;
+  r.core=Cpu::core();r.debugger=Cpu::debugger();
+  const auto mask=Cpu::maskInterrupts();
+  r.before=Cpu::select();r.controlBefore=Cpu::control();
+  for(unsigned i=0;i<3;++i) {
+    Cpu::select(i);r.slots[i].selected=Cpu::select();
+    r.selected=r.selected && r.slots[i].selected==i;
+    r.slots[i].data1=Cpu::data1();r.slots[i].data2=Cpu::data2();r.slots[i].data3=Cpu::data3();
+  }
+  Cpu::select(r.before);r.after=Cpu::select();r.controlAfter=Cpu::control();
+  r.restored=r.before==r.after && r.controlBefore==r.controlAfter;
+  Cpu::restoreInterrupts(mask);
+  return r;
+}
+}
diff --git a/components/hardwareone/stt/heap_watch_readback.h b/components/hardwareone/stt/heap_watch_readback.h
new file mode 100644
index 00000000..bb1c9b54
--- /dev/null
+++ b/components/hardwareone/stt/heap_watch_readback.h
@@ -0,0 +1,58 @@
+#pragma once
+// Diagnostic-only discovery: no watchpoint/breakpoint arming or clearing.
+#include "heap_trigger_read.h"
+#include "esp_cpu.h"
+#include "esp_ipc.h"
+#include "esp_log.h"
+#include "riscv/rv_utils.h"
+#include "soc/soc_caps.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+static_assert(SOC_CPU_WATCHPOINTS_NUM==3 && sizeof(void*)==4);
+extern "C" char _ext_ram_bss_end;
+namespace hw1::stt {
+struct HeapTriggerCpu {
+  static uint32_t core(){return esp_cpu_get_core_id();}
+  static uint32_t debugger(){return esp_cpu_dbgr_is_attached();}
+  static UBaseType_t maskInterrupts(){return portSET_INTERRUPT_MASK_FROM_ISR();}
+  static void restoreInterrupts(UBaseType_t previous){portCLEAR_INTERRUPT_MASK_FROM_ISR(previous);}
+  static uint32_t select(){return RV_READ_CSR(tselect);}
+  static void select(uint32_t value){RV_WRITE_CSR(tselect,value);}
+  static uint32_t control(){return RV_READ_CSR(tcontrol);}
+  static uint32_t data1(){return RV_READ_CSR(tdata1);}
+  static uint32_t data2(){return RV_READ_CSR(tdata2);}
+  static uint32_t data3(){return RV_READ_CSR(tdata3);}
+};
+static void heapTriggerReadOnCore(void* argument) {
+  *static_cast<HeapTriggerRead*>(argument)=readHeapTriggers<HeapTriggerCpu>();
+}
+static bool heapWatchReadback(unsigned stage) {
+  bool all=true;
+  for(unsigned core=0;core<2;++core) {
+    HeapTriggerRead r;
+    const esp_err_t error=core==esp_cpu_get_core_id() ? (heapTriggerReadOnCore(&r),ESP_OK)
+      : esp_ipc_call_blocking(core,heapTriggerReadOnCore,&r);
+    const bool ok=error==ESP_OK && r.core==core && r.restored && r.selected;
+    all=all && ok;
+    ESP_LOGI("STT","TL hwread stage=%u core=%u ok=%u error=%u debugger=%u before=%u after=%u control_before=%lu control_after=%lu end",
+             stage,core,unsigned(ok),unsigned(error),unsigned(r.debugger),unsigned(r.before),unsigned(r.after),
+             (unsigned long)r.controlBefore,(unsigned long)r.controlAfter);
+    ESP_LOGI("STT","TL hwslots stage=%u core=%u selected0=%u data10=%lu data20=%lu selected1=%u data11=%lu data21=%lu selected2=%u data12=%lu data22=%lu end",
+             stage,core,unsigned(r.slots[0].selected),(unsigned long)r.slots[0].data1,(unsigned long)r.slots[0].data2,
+             unsigned(r.slots[1].selected),(unsigned long)r.slots[1].data1,(unsigned long)r.slots[1].data2,
+             unsigned(r.slots[2].selected),(unsigned long)r.slots[2].data1,(unsigned long)r.slots[2].data2);
+    ESP_LOGI("STT","TL hwcontext stage=%u core=%u data30=%lu data31=%lu data32=%lu end",
+             stage,core,(unsigned long)r.slots[0].data3,(unsigned long)r.slots[1].data3,(unsigned long)r.slots[2].data3);
+  }
+  const uintptr_t heap=reinterpret_cast<uintptr_t>(&_ext_ram_bss_end);
+  const uint32_t control=*reinterpret_cast<volatile const uint32_t*>(heap+16);
+  // Layout is the installed non-ROM multi_heap.c: five 32-bit fields, TLSF
+  // control initialized immediately after it. Record first; never write it.
+  const bool layout=control==heap+20;
+  ESP_LOGI("STT","TL hwheap stage=%u heap=%lu field=%lu value=%lu expected=%lu ok=%u end",
+           stage,(unsigned long)heap,(unsigned long)(heap+16),(unsigned long)control,
+           (unsigned long)(heap+20),unsigned(layout));
+  ESP_LOGI("STT","TL hwread_done stage=%u ok=%u cores=2 slots=6 contexts=6 heap_ok=%u end",stage,unsigned(all),unsigned(layout));
+  return all;
+}
+}
