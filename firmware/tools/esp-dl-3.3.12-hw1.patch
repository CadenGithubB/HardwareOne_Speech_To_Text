+// HardwareOne: 64-channel column blocks for single-column int8 depthwise layers.
+// The kernel computes one output row across all channels per call. For [K,1] filters
+// (the 15x5 has K = 33..87) one row touches K input rows x C bytes plus the whole
+// K x C filter (~77 KB at K = 75, C = 512), more than the 64 KB L1D, so every output
+// row refetched both from L2. The same kernel run on 64 channels (one 64-byte line
+// per row) across all rows keeps the sliding window and the block's filter in L1.
+// Same kernel, per-channel shifts and border handling, per block: bit-identical
+// output. The filter is group-major (16 channels x K taps contiguous) and the
+// per-channel shifts advance 16 bytes per group, so a block is four pointer offsets.
+// With two tasks, core 1 walks the blocks in reverse so the cores never work on the
+// same block, whose rows map to the same L1D sets.
+static bool dwconv_column_blocks(
+    ConvArgsType &args, conv_pie_fn_t body, conv_pie_fn_t border, int feat_bytes, int filt_bytes)
+{
+    constexpr int kGroupsPerBlock = 4;
+    constexpr int kBlockChannels = kGroupsPerBlock * 16;
+    const int groups = args.c_div_x_1 + 1;
+    if (feat_bytes != 1 || filt_bytes != 1 || args.input_width != 1 || args.output_width != 1 ||
+        args.filter_width != 1 || args.c_remainder || args.n_remainder || groups <= kGroupsPerBlock ||
+        groups % kGroupsPerBlock || args.bias_element || args.activation_alpha_ptr ||
+        args.input_channel != args.output_channel || args.n_div_x != groups) {
+        return false;
+    }
+    const int blocks = groups / kGroupsPerBlock;
+    const bool reverse = esp_cpu_get_core_id() == 1;
+    for (int i = 0; i < blocks; i++) {
+        const int b = reverse ? blocks - 1 - i : i;
+        ConvArgsType a = args;
+        a.input_element = conv_ptr_add(args.input_element, b * kBlockChannels, 1);
+        a.output_element = conv_ptr_add(args.output_element, b * kBlockChannels, 1);
+        a.filter_element = conv_ptr_add(args.filter_element, b * kBlockChannels * args.filter_height, 1);
+        a.filter_element_unaligned = a.filter_element;
+        if (args.tie_filter_channel_factor) {
+            a.tie_filter_channel_factor = conv_ptr_add(args.tie_filter_channel_factor, b * kBlockChannels, 1);
+        }
+        a.c_div_x_1 = kGroupsPerBlock - 1;
+        a.n_div_x = kGroupsPerBlock;
+        dwconv_loop_pie(a, body, border, feat_bytes, filt_bytes);
+    }
+    return true;
+}
