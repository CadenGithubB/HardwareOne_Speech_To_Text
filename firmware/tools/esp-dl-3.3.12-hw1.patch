@@ -0,0 +1,20 @@
+############################################################################################################################################################
+#### HardwareOne: int8 ReLU, out[i] = max(in[i], 0), 16 bytes per step (used for LUTs that are exactly ReLU).
+#### a0: int8_t *output (16-byte aligned), a1: const int8_t *input (16-byte aligned), a2: number of 16-byte vectors (>= 0)
+############################################################################################################################################################
+    .text
+    .global dl_esp32p4_s8_relu_hw1
+    .type   dl_esp32p4_s8_relu_hw1, @function
+    .balign 4
+    .option norvc
+dl_esp32p4_s8_relu_hw1:
+    esp.zero.q  q1
+    beqz  a2, 2f
+1:
+    esp.vld.128.ip  q0, a1, 16
+    esp.vmax.s8     q0, q0, q1
+    esp.vst.128.ip  q0, a0, 16
+    addi  a2, a2, -1
+    bnez  a2, 1b
+2:
+    ret
diff --git a/dl/tool/src/dl_tool_metadata.cpp b/dl/tool/src/dl_tool_metadata.cpp
new file mode 100644
index 0000000..28e2c8e
--- /dev/null
+++ b/dl/tool/src/dl_tool_metadata.cpp
@@ -0,0 +1,111 @@
+// HardwareOne tree-local addition: see dl_tool_metadata.hpp.
+// HW1-HOSTTEST: test_dl_metadata.py compiles this file on the host against fakes of the three
+// ESP-IDF headers below and of malloc_aligned.
+#include "dl_tool_metadata.hpp"
+#include <atomic>
+#include <cstdlib>
+#include "esp_heap_caps.h"
+#include "esp_log.h"
+#include "esp_memory_utils.h"
+
+namespace dl {
+namespace tool {
+
+void *malloc_aligned(size_t size, uint32_t caps); // dl_tool.cpp (upstream)
+
+namespace {
+std::atomic<const MetadataAllocator *> s_allocator{nullptr};
+std::atomic<uint32_t> s_foreign_objects{0};
+std::atomic<uint32_t> s_foreign_internal{0};
+
+// Upstream placement, used while no allocator is installed: the module, tensor and exponent
+// blocks came from malloc_aligned(MALLOC_CAP_DEFAULT) (16-byte aligned), everything else from
+// plain new (std::allocator), i.e. malloc.
+void *upstream_alloc(size_t size, size_t align, MetadataKind kind)
+{
+    switch (kind) {
+    case MetadataKind::Module:
+    case MetadataKind::Tensor:
+    case MetadataKind::Exponent:
+        return malloc_aligned(size, MALLOC_CAP_DEFAULT);
+    default:
+        break;
+    }
+    if (align <= alignof(std::max_align_t)) {
+        return std::malloc(size);
+    }
+    return nullptr; // no metadata site asks for more than 16
+}
+} // namespace
+
+const char *metadata_kind_name(MetadataKind kind)
+{
+    static const char *const names[kMetadataKinds] = {
+        "model", "ctx", "loader", "fbs", "module", "tensor", "exp", "shape", "index", "list", "names"};
+    const size_t k = static_cast<size_t>(kind);
+    return k < kMetadataKinds ? names[k] : "?";
+}
+
+void set_metadata_allocator(const MetadataAllocator *allocator)
+{
+    s_allocator.store(allocator, std::memory_order_release);
+}
+
+const MetadataAllocator *get_metadata_allocator()
+{
+    return s_allocator.load(std::memory_order_acquire);
+}
+
+void *metadata_alloc(size_t size, size_t align, MetadataKind kind)
+{
+    if (size == 0) {
+        size = 1;
+    }
+    if (align == 0 || (align & (align - 1)) != 0) {
+        return nullptr;
+    }
+    const MetadataAllocator *allocator = s_allocator.load(std::memory_order_acquire);
+    return allocator ? allocator->alloc(size, align, kind) : upstream_alloc(size, align, kind);
+}
+
+void metadata_free(void *ptr)
+{
+    if (!ptr) {
+        return;
+    }
+    const MetadataAllocator *allocator = s_allocator.load(std::memory_order_acquire);
+    if (allocator) {
+        allocator->free(ptr);
+    } else {
+        std::free(ptr); // ESP-IDF: free() == heap_caps_free(), aligned blocks included
+    }
+}
+
+void metadata_bad_alloc(size_t size, MetadataKind kind)
+{
+    ESP_LOGE("dl::metadata", "Failed to allocate %u bytes of %s metadata", (unsigned)size, metadata_kind_name(kind));
+#if defined(__cpp_exceptions)
+    throw std::bad_alloc();
+#else
+    std::abort();
+#endif
+}
+
+void metadata_note_foreign(const void *object)
+{
+    if (!object) {
+        return;
+    }
+    s_foreign_objects.fetch_add(1, std::memory_order_relaxed);
+    if (!esp_ptr_external_ram(object)) {
+        s_foreign_internal.fetch_add(1, std::memory_order_relaxed);
+    }
+}
+
+MetadataForeignStats metadata_foreign_stats()
+{
+    return {s_foreign_objects.load(std::memory_order_relaxed), s_foreign_internal.load(std::memory_order_relaxed)};
+}
+
+} // namespace tool
+} // namespace dl
