menu "Standalone captions streaming"
config CAPTIONS_STREAM_METRICS
    bool "Collect bounded streaming lock and capture diagnostics"
    default n
    help
        Adds operation timing, memory-traffic counters and I2S loss counters.
        Use the USB command perf dump between test inputs. Results are emitted
        outside the streaming lock. This changes timing and needs overhead controls.
config CAPTIONS_CAPTURE_FEATURES
    bool "Compute reusable features during capture"
    default y
config CAPTIONS_CLEAR_COMMITTED_FEATURES
    bool "Clear only committed feature-cache rows (experimental)"
    depends on CAPTIONS_CAPTURE_FEATURES
    default n
    help
        Preserve initial whole-pool clearing, then clear the complete written
        prefix on retirement. Reader pins and generation checks remain intact.
        Requires the capture-lock qualification described in the project plan.
config CAPTIONS_DRAFTS
    bool "Publish preemptible live drafts"
    default y
config CAPTIONS_X2F_DRAFT_PACING
    bool "Use x2 compute-paced drafts with a fast first draft (experimental)"
    depends on CAPTIONS_DRAFTS
    default n
    help
        Keep a one-second audio floor for the first preview, then require
        at least 600 ms of new audio or twice the previous draft compute time.
        A new phrase does not inherit a slow previous phrase's draft delay.
        Requires standalone device latency/accuracy qualification.
config CAPTIONS_TRIM_SILENCE
    bool "Retain 500 ms of trailing silence (requires audio qualification)"
    default n
config CAPTIONS_SPECULATIVE_FINAL
    bool "Compute exact speculative finals before segment closure"
    depends on CAPTIONS_TRIM_SILENCE
    default y
endmenu
